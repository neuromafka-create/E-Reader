{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E-Reader",
  "version": "0.1.0",
  "identifier": "com.mafka.ereader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "E-Reader",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "focus": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "E-Reader",
    "category": "Education",
    "shortDescription": "Desktop e-reader for EPUB, FB2, TXT, and Markdown",
    "longDescription": "A lightweight desktop e-reader built with Rust and Tauri. Read EPUB, FictionBook (FB2), plain text, and Markdown with library management, bookmarks, and reading progress.",
    "copyright": "Copyright © 2026",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "E-Reader"
      }
    },
    "fileAssociations": [
      {
        "ext": ["epub"],
        "name": "EPUB Book",
        "description": "EPUB e-book",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      },
      {
        "ext": ["fb2"],
        "name": "FictionBook",
        "description": "FictionBook e-book",
        "role": "Viewer",
        "mimeType": "application/x-fictionbook+xml"
      },
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["txt"],
        "name": "Text Document",
        "description": "Plain text document",
        "role": "Viewer",
        "mimeType": "text/plain"
      }
    ]
  }
}
